# Data (raw dataset is ~500MB+ — never commit)
data/raw/
*.csv
*.parquet
!reports/**/*.csv

# Models: only the final XGBoost pipeline + its metadata are committed so the
# dashboard works straight after cloning; everything else is regenerated by training.
models/*
!models/.gitkeep
!models/xgb_pipeline.joblib
!models/metadata.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Secrets
.env
logs/
data/processed/

# Personal interview prep (kept local, not published)
INTERVIEW_NOTES.md
